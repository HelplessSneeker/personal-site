---
/**
 * Variante C — „Anzeigetafel".
 *
 * Lane: die Live-Daten sind der Entwurf. Vorbild ist die Abfahrtstafel, nicht
 * das Portfolio: ein getränktes Tintenfeld oben, darunter eine Tafel aus
 * großen Zahlen. Farbstrategie „Drenched" im Hero, das Signalgrün markiert
 * ausschließlich, was gerade lebt.
 *
 * Hero-Text: Richtung A.
 * Interaktion: die Werte zählen beim Laden hoch, die Stand-Zeile tickt weiter.
 */
import LookLayout from '../../layouts/LookLayout.astro';
import { heroA, tiles, stand, portraitPlaceholder } from '../../data/lookVariants';
---

<LookLayout title="Look C · Anzeigetafel">
  <div class="board">
    <section class="field">
      <div class="field-inner">
        <p class="eyebrow"><i aria-hidden="true"></i>zwölf Agenten, ein Mensch</p>
        <h1>{heroA.name}</h1>
        <p class="lede">{heroA.line}</p>

        <figure class="portrait">
          <div class="portrait-slot">
            <span>{portraitPlaceholder.slot}</span>
            <span class="portrait-spec">{portraitPlaceholder.spec}</span>
          </div>
          <figcaption>{portraitPlaceholder.status}</figcaption>
        </figure>
      </div>
    </section>

    <section class="panel">
      <header>
        <h2>Gerade jetzt</h2>
        <p>Alle fünfzehn Minuten geschoben. Bleibt der Push aus, wird die Zeile älter statt falsch.</p>
      </header>

      <div class="rows">
        {
          tiles.map((tile, i) => (
            <article class="row" style={`--i:${i}`}>
              <h3>{tile.label}</h3>
              <p class="value" data-value={tile.value}>
                {tile.value}
              </p>
              <p class="text">{tile.note}</p>
              <p class="meta">{stand(tile.capturedAt)}</p>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</LookLayout>

<script>
  // Hochzählen nur dort, wo der Wert mit einer Zahl beginnt und keine Uhrzeit
  // ist — „08:33" rückwärts zu zählen wäre albern.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    for (const el of document.querySelectorAll<HTMLElement>('.value')) {
      const raw = el.dataset.value ?? '';
      // Uhrzeiten bleiben stehen: „08:33" hochzählen verliert die führende Null
      // und liest sich als Countdown, den es nicht gibt.
      if (raw.includes(':')) continue;
      const match = /^(\d+)(\D.*)?$/.exec(raw);
      if (!match) continue;
      const target = Number(match[1]);
      const suffix = match[2] ?? '';
      const start = performance.now();
      const dur = 900;
      const tick = (t: number) => {
        const p = Math.min(1, (t - start) / dur);
        const eased = 1 - Math.pow(1 - p, 4);
        el.textContent = `${Math.round(target * eased)}${suffix}`;
        if (p < 1) requestAnimationFrame(tick);
      };
      el.textContent = `0${suffix}`;
      requestAnimationFrame(tick);
    }
  }
</script>

<style>
  .board {
    --field: oklch(24% 0.055 252);
    --field-deep: oklch(19.5% 0.05 252);
    --bone: oklch(94.8% 0.013 88);
    --cream: oklch(96% 0.015 86);
    --ink: oklch(22% 0.03 252);
    --ink-muted: oklch(46% 0.025 252);
    --on-field-muted: oklch(74% 0.028 250);
    --signal: oklch(80% 0.185 132);
    --hair: oklch(84% 0.014 88);

    --font-display: 'Supreme', 'General Sans', sans-serif;
    --font-body: 'Switzer', 'General Sans', sans-serif;
    --font-mono: 'Commit Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

    min-height: 100vh;
    padding-bottom: 5rem;
    background: var(--bone);
    color: var(--ink);
    font-family: var(--font-body);
  }

  /* Getränkt: das Feld hört nicht am Container auf, es IST die obere Hälfte. */
  .field {
    background: var(--field);
    color: var(--cream);
  }
  .field-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.85fr);
    grid-template-areas:
      'eyebrow portrait'
      'name    portrait'
      'lede    portrait';
    align-content: center;
    gap: 0 clamp(2rem, 6vw, 5rem);
    max-width: 84rem;
    margin: 0 auto;
    padding: clamp(4rem, 11vw, 8.5rem) clamp(1.25rem, 5vw, 4rem) clamp(4rem, 9vw, 7rem);
  }

  .eyebrow {
    grid-area: eyebrow;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--signal);
  }
  .eyebrow i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 0 oklch(80% 0.185 132 / 0.6);
    animation: ping 2.6s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  @keyframes ping {
    0% {
      box-shadow: 0 0 0 0 oklch(80% 0.185 132 / 0.55);
    }
    60%,
    100% {
      box-shadow: 0 0 0 10px oklch(80% 0.185 132 / 0);
    }
  }

  h1 {
    grid-area: name;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 7.6vw, 6rem);
    line-height: 0.94;
    letter-spacing: -0.032em;
    text-wrap: balance;
  }

  .lede {
    grid-area: lede;
    max-width: 38ch;
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    /* Heller Text auf dunklem Grund braucht mehr Durchschuss. */
    font-size: clamp(1.0625rem, 0.95rem + 0.55vw, 1.375rem);
    line-height: 1.6;
    color: var(--on-field-muted);
  }

  .portrait {
    grid-area: portrait;
    align-self: center;
    margin: 0;
  }
  .portrait-slot {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.5rem;
    aspect-ratio: 4 / 5;
    padding: 1.25rem;
    border: 1px dashed oklch(60% 0.03 250);
    color: var(--on-field-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.6;
  }
  .portrait-slot > span:first-child {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    color: var(--cream);
  }
  .portrait figcaption {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--on-field-muted);
  }

  .panel {
    max-width: 84rem;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) clamp(1.25rem, 5vw, 4rem) 0;
  }
  .panel header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--ink);
  }
  .panel h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    letter-spacing: -0.025em;
  }
  .panel header p {
    margin: 0;
    max-width: 44ch;
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  /* Tafelzeilen, keine Kacheln: die Werte stehen in einer Spalte untereinander
     und lassen sich zeilenweise lesen wie eine Abfahrtstafel. */
  .rows {
    display: grid;
  }
  .row {
    display: grid;
    grid-template-columns: 13rem minmax(0, 12rem) minmax(0, 1fr) 9rem;
    align-items: baseline;
    gap: 0 clamp(1rem, 3vw, 2.5rem);
    padding: clamp(1.25rem, 2.2vw, 1.75rem) 0;
    border-bottom: 1px solid var(--hair);
    animation: rise 620ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i) * 70ms + 120ms);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .row h3 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .value {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .text {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }
  .meta {
    margin: 0;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }

  @media (max-width: 68rem) {
    .field-inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'eyebrow'
        'name'
        'lede'
        'portrait';
    }
    .portrait {
      max-width: 17rem;
      margin-top: clamp(2rem, 5vw, 3rem);
    }
    .row {
      grid-template-columns: minmax(0, 1fr) 8rem;
      grid-template-areas:
        'label meta'
        'value value'
        'text  text';
      gap: 0.35rem 1rem;
    }
    .row h3 { grid-area: label; }
    .value { grid-area: value; }
    .text { grid-area: text; }
    .meta { grid-area: meta; }
  }
</style>
