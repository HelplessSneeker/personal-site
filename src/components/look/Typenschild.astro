---
/**
 * Variante A — „Typenschild". Von bfn am 03.09.2026 gewählt.
 *
 * Lane: warm-industriell. Das Vorbild ist kein Portfolio, sondern das
 * Metallschild an einer Maschine: strenges Raster, Haarlinien, gestanzte
 * Beschriftung, eine kräftige Farbe. Farbstrategie „Committed" — der
 * Trägerton füllt Porträtfläche und Trennband, nicht bloß ein paar Links.
 *
 * Der Trägerton kommt als Prop, weil bfn Blau statt Minium wollte und die
 * Wahl zwischen den Blautönen wieder gerendert stattfindet statt im Chat.
 *
 * Hero-Text: Richtung A.
 * Interaktion: die Fußzeile jeder Kachel wechselt bei Hover von „Stand" auf
 * „Quelle" — die Seite zeigt, woher sie ihre Zahlen hat, statt es zu behaupten.
 */
import { heroA, tiles, stand, portraitPlaceholder } from '../../data/lookVariants';
import { paletteStyle, type Palette } from '../../data/lookPalettes';

interface Props {
  palette: Palette;
}
const { palette } = Astro.props;
---

<div class="plate" style={paletteStyle(palette)}>
    <header class="strip">
      <span>Benjamin Franz Nößler</span>
      <span aria-hidden="true">·</span>
      <span>Wien / Kärnten</span>
      <span class="strip-spacer"></span>
      <span class="strip-live"><i></i>online</span>
    </header>

    <section class="hero">
      <div class="hero-text">
        <p class="eyebrow">Diese Seite ist keine Beraterseite</p>
        <h1>{heroA.name}</h1>
        <p class="lede">{heroA.line}</p>
      </div>

      <figure class="portrait">
        <div class="portrait-label">
          <span class="portrait-slot">{portraitPlaceholder.slot}</span>
          <span class="portrait-spec">{portraitPlaceholder.spec}</span>
        </div>
        <figcaption>{portraitPlaceholder.status}</figcaption>
      </figure>
    </section>

    <div class="band">
      <h2>Gerade jetzt</h2>
      <p>Sechs Werte aus meinem Alltag. Alle mit Zeitstempel, auch die alten.</p>
    </div>

    <section class="grid">
      {
        tiles.map((tile) => (
          <article class="cell">
            <h3>{tile.label}</h3>
            <p class="value">{tile.value}</p>
            <p class="note">{tile.note}</p>
            <p class="meta">
              <span class="meta-stand">Stand: {stand(tile.capturedAt)}</span>
              <span class="meta-source">Quelle: {tile.source}</span>
            </p>
          </article>
        ))
      }
    </section>
</div>

<style>
  .plate {
    /* --bone, --ink, --carrier und Verwandte setzt die Farbton-Prop. */

    /* Seitensteg und Zellenpolster getrennt benannt: die Kachelzeile läuft
       randlos durch, ihre Beschriftung muss aber auf derselben Kante sitzen
       wie Hero und Band. Die Differenz kompensiert der Rahmen unten. */
    --page: clamp(1.25rem, 4vw, 3.5rem);
    --cell-pad: clamp(1.25rem, 2.5vw, 2rem);

    --font-display: 'Clash Display', 'General Sans', sans-serif;
    --font-body: 'Switzer', 'General Sans', sans-serif;
    --font-mono: 'Commit Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

    min-height: 100vh;
    padding-bottom: 5rem;
    background: var(--bone);
    color: var(--ink);
    font-family: var(--font-body);
    font-weight: 400;
  }

  /* Die Kopfleiste ist das eigentliche Typenschild: Mono, gesperrt,
     hart auf Kante gesetzt. Sie sagt nichts Wichtiges, sie gibt den Ton an. */
  .strip {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem var(--page);
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .strip-spacer {
    flex: 1;
  }
  .strip-live {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--carrier-deep);
  }
  .strip-live i {
    width: 6px;
    height: 6px;
    background: var(--carrier);
    animation: pulse 2.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  @keyframes pulse {
    0%,
    70%,
    100% {
      opacity: 1;
    }
    85% {
      opacity: 0.25;
    }
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: end;
    padding: clamp(3rem, 9vw, 7rem) var(--page) clamp(3rem, 7vw, 5rem);
  }

  .eyebrow {
    margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--carrier-deep);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.75rem, 8.2vw, 6.5rem);
    line-height: 0.9;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .lede {
    max-width: 34ch;
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.3125rem);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  /* Platzhalter, kein Bild. Beschriftet statt grau — solange die Fotografin
     nicht geliefert hat, soll die Fläche sagen, was hineingehört. */
  .portrait {
    margin: 0;
  }
  .portrait-label {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.5rem;
    aspect-ratio: 4 / 5;
    padding: 1.5rem;
    background: var(--carrier);
    color: var(--on-carrier);
  }
  .portrait-slot {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.75rem;
    letter-spacing: -0.02em;
  }
  .portrait-spec {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.6;
    letter-spacing: 0.04em;
    opacity: 0.86;
  }
  .portrait figcaption {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }

  .band {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    padding: 1.15rem var(--page);
    background: var(--carrier);
    color: var(--on-carrier);
  }
  .band h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }
  .band p {
    margin: 0;
    font-size: 0.9375rem;
    opacity: 0.88;
  }

  /* Kein Kartenraster, sondern eine Tabelle aus Haarlinien. Die Zellen liegen
     im selben Feld, statt einzeln aufgeklebt zu wirken. */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--rule);
    border-bottom: 1px solid var(--rule);
    border-inline: calc(var(--page) - var(--cell-pad)) solid var(--bone);
  }
  .cell {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 2.5vw, 2.25rem) var(--cell-pad) 1.25rem;
    background: var(--bone);
    transition: background 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cell:hover {
    background: var(--bone-sunk);
  }

  .cell h3 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .value {
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .note {
    margin: 0.85rem 0 0;
    max-width: 30ch;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  /* Die eine Interaktion des Entwurfs: Stand raus, Quelle rein. */
  .meta {
    position: relative;
    margin: auto 0 0;
    padding-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
  }
  .meta-stand,
  .meta-source {
    display: block;
    transition: opacity 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .meta-source {
    position: absolute;
    inset: auto 0 0 0;
    opacity: 0;
    color: var(--carrier-deep);
  }
  .cell:hover .meta-stand {
    opacity: 0;
  }
  .cell:hover .meta-source {
    opacity: 1;
  }

  @media (max-width: 62rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
    .portrait {
      max-width: 20rem;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 40rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
