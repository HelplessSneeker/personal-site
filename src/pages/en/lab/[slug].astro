---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import WerkstattEntry from '../../../components/WerkstattEntry.astro';
import { getAltUrl } from '../../../i18n/util';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('werkstatt');
  return entries
    .filter((entry) => entry.data.locale === 'en' && !entry.data.draft)
    .map((entry) => ({ params: { slug: entry.data.key }, props: { entry } }));
}

const locale = 'en' as const;
const { entry } = Astro.props;
const altUrl = getAltUrl(Astro.url.pathname, locale);
---
<BaseLayout
  title={`${entry.data.title} — Lab`}
  description={entry.data.summary}
  locale={locale}
  altLocaleUrl={altUrl}
  canonicalPath={`/en/lab/${entry.data.key}`}
>
  <Header locale={locale} />
  <main id="main">
    <WerkstattEntry locale={locale} entry={entry} />
  </main>
  <Footer locale={locale} />
</BaseLayout>
