---
/**
 * Auswahlseite. Kein Entwurf, sondern der Zettel daneben: was unterscheidet
 * die drei, worauf soll bfn schauen. Fliegt mit dem Rest von /look/ raus,
 * sobald eine Variante gewonnen hat.
 */
import LookLayout from '../../layouts/LookLayout.astro';

import { palettes } from '../../data/lookPalettes';

const beaten = [
  {
    id: 'b',
    name: 'Kladde',
    why: 'Handgemacht, Panchang, Zettel an der Pinnwand. Trägt Hero B — der Vergleich, gegen den sich Hero A durchgesetzt hat.',
  },
  {
    id: 'c',
    name: 'Anzeigetafel',
    why: 'Getränktes Tintenfeld, Tafelzeilen statt Kacheln. Bleibt liegen, bis der Rohbau steht.',
  },
];
---

<LookLayout title="Look-Varianten · Persona-Showcase">
  <main>
    <header>
      <p class="eyebrow">Personal Site · Persona-Showcase</p>
      <h1>A hat gewonnen, jetzt der Ton</h1>
      <p class="lede">
        bfn hat am 03.09.2026 Variante A gewählt und Blau statt Minium verlangt. Drei Trägertöne
        auf demselben Entwurf; der Grund bleibt in allen dreien warmes Bein. Was gewinnt, kommt in
        <code>DESIGN.md</code>. B und C stehen weiter, damit der Vergleich nachvollziehbar bleibt.
      </p>
    </header>

    <ol>
      {
        palettes.map((p) => (
          <li>
            <a href={`/look/a/${p.id}`}>
              <span class="tag">A</span>
              <span class="name">{p.name}</span>
            </a>
            <dl>
              <div><dt>Charakter</dt><dd>{p.character}</dd></div>
            </dl>
          </li>
        ))
      }
      {
        beaten.map((v) => (
          <li>
            <a href={`/look/${v.id}`}>
              <span class="tag">{v.id.toUpperCase()}</span>
              <span class="name">{v.name}</span>
              <span class="lane">geschlagen</span>
            </a>
            <dl>
              <div><dt>Was war</dt><dd>{v.why}</dd></div>
            </dl>
          </li>
        ))
      }
    </ol>

    <footer>
      <h2>Worauf es beim Anschauen ankommt</h2>
      <ul>
        <li>Trägt der Ton die Porträtfläche, oder wirkt sie wie ein Platzhalter, der auf ein Bild wartet?</li>
        <li>Ist das Band über der Kachelreihe zu laut, zu leise, oder richtig?</li>
        <li>Die Kochwochen-Kachel ist absichtlich zwei Tage alt — ist die ehrliche Degradation sichtbar genug?</li>
        <li>Die Porträtfläche ist beschrifteter Platzhalter, kein Bild. Trägt die Komposition trotzdem?</li>
      </ul>
    </footer>
  </main>
</LookLayout>

<style>
  main {
    --paper: oklch(96.5% 0.008 250);
    --ink: oklch(22% 0.02 250);
    --muted: oklch(48% 0.018 250);
    --hair: oklch(87% 0.01 250);

    min-height: 100vh;
    max-width: 60rem;
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) clamp(1.25rem, 5vw, 3rem) 7rem;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Switzer', system-ui, sans-serif;
  }
  .eyebrow {
    margin: 0 0 1rem;
    font-family: 'Commit Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  h1 {
    margin: 0;
    font-family: 'Clash Display', sans-serif;
    font-weight: 600;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .lede {
    max-width: 60ch;
    margin: 1.25rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted);
  }
  code {
    font-family: 'Commit Mono', ui-monospace, monospace;
    font-size: 0.9em;
  }

  ol {
    display: grid;
    gap: 2.5rem;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }
  li {
    padding-top: 1.75rem;
    border-top: 1px solid var(--hair);
  }
  li a {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    color: inherit;
    text-decoration: none;
  }
  .tag {
    font-family: 'Commit Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    padding: 0.2rem 0.45rem;
    background: var(--ink);
    color: var(--paper);
  }
  .name {
    font-family: 'Clash Display', sans-serif;
    font-weight: 600;
    font-size: 1.625rem;
    letter-spacing: -0.02em;
  }
  li a:hover .name {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .lane {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  dl {
    display: grid;
    gap: 0.4rem;
    margin: 1rem 0 0;
  }
  dl > div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  dt {
    font-family: 'Commit Mono', ui-monospace, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.25em;
  }
  dd {
    margin: 0;
  }

  footer {
    margin-top: 4rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--hair);
  }
  footer h2 {
    margin: 0 0 1rem;
    font-family: 'Clash Display', sans-serif;
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.015em;
  }
  footer ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.5rem;
    max-width: 62ch;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (max-width: 34rem) {
    dl > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }
  }
</style>
