---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Intro from '../../components/Intro.astro';
import NowTeaser from '../../components/NowTeaser.astro';
import SelectedWork from '../../components/SelectedWork.astro';
import WerkstattTeaser from '../../components/WerkstattTeaser.astro';
import Contact from '../../components/Contact.astro';
import { t, getAltUrl } from '../../i18n/util';

export const prerender = true;

const locale = 'en' as const;
const altUrl = getAltUrl(Astro.url.pathname, locale);
---
<BaseLayout
  title={t(locale, 'home.metaTitle')}
  description={t(locale, 'home.description')}
  locale={locale}
  altLocaleUrl={altUrl}
  canonicalPath="/en/"
>
  <Header locale={locale} />
  <main id="main">
    <Intro locale={locale} />
    <NowTeaser locale={locale} />
    <SelectedWork locale={locale} />
    <WerkstattTeaser locale={locale} />
    <Contact locale={locale} variant="closing" />
  </main>
  <Footer locale={locale} />
</BaseLayout>
