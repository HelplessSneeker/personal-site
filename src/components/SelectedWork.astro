---
import { t, type Locale, getLocalizedPath } from '../i18n/util';
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

/* Homepage teaser, not a second portfolio. /portfolio carries all three
   tracks in full; here we show client work only, capped, and hand off. The
   previous version rendered both tracks completely, which made the homepage
   and /portfolio near-duplicates. */
const TEASER_LIMIT = 3;
const shipped = projects.filter(
  (p) => p.status === 'live' || p.status === 'in-development'
);
const clientProjects = shipped
  .filter((p) => p.track === 'client')
  .slice(0, TEASER_LIMIT);
const portfolioHref = getLocalizedPath(locale, '/portfolio');
---
<section class="section work-section" id="work" aria-labelledby="work-heading">
  <div class="container">
    <h2 id="work-heading" class="section-label">{t(locale, 'homeWork.label')}</h2>
    <p class="section-lede">{t(locale, 'homeWork.lede')}</p>

    {clientProjects.length > 0 && (
      <div class="project-list" role="list">
        {clientProjects.map((project, i) => (
          <ProjectCard project={project} locale={locale} index={i} />
        ))}
      </div>
    )}

    <p class="work-more">
      <a href={portfolioHref}>{t(locale, 'homeWork.link')}</a>
    </p>
  </div>
</section>

<style>
  .project-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--color-rule);
    margin-top: var(--space-4);
  }

  .work-more {
    margin-block-start: var(--space-6);
    font-size: var(--fs-sm);
  }
</style>
