---
import { operatedSystems, formatRunningSince } from '../data/operated';
import { t, type Locale } from '../i18n/util';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const sinceLabel = t(locale, 'portfolioPage.tracks.operated.sinceLabel');
---
{/*
  Track 3 is deliberately a different object from tracks 1 and 2: no card, no
  screenshot, no stack panel, no feature bullets. A ledger. The running-since
  column leads each row so the tabular figures stack into one vertical line
  down the page, which is what makes the dates read as a record rather than as
  seven separate claims (PRODUCT.md: "facts with dates").
*/}
<ul class="operated-list" role="list">
  {operatedSystems.map((system) => (
    <li class="operated-entry">
      <p class="operated-since">
        <span class="operated-since-label">{sinceLabel}</span>
        <time class="operated-since-value tabular" datetime={system.runningSince}>
          {formatRunningSince(system.runningSince)}
        </time>
      </p>
      <div class="operated-text">
        <h3 class="operated-name">{locale === 'de' ? system.name.de : system.name.en}</h3>
        <p class="operated-role">{locale === 'de' ? system.role.de : system.role.en}</p>
        {system.note && (
          <p class="operated-note">{locale === 'de' ? system.note.de : system.note.en}</p>
        )}
      </div>
    </li>
  ))}
</ul>

<style>
  .operated-list {
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0 0 0;
    border-top: 1px solid var(--color-rule);
  }

  .operated-entry {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-rule);
  }

  /* The date column only earns its own track once there is room for the full
     mono string plus a real gutter; below that it sits above the name as a
     leading metadatum. `max-content` rather than a fixed width: every entry
     renders the same label plus a fixed-width MM/YYYY in a monospace face, so
     the column measures identically on each row and lands on the same edge in
     both locales without a per-language magic number. */
  @media (min-width: 52rem) {
    .operated-entry {
      grid-template-columns: max-content minmax(0, 1fr);
      column-gap: var(--space-6);
      row-gap: var(--space-2);
      align-items: baseline;
      padding-block: var(--space-6);
    }
  }

  .operated-since {
    margin: 0;
    font-family: var(--font-mono);
    font-feature-settings: var(--font-features-mono);
    font-size: var(--fs-md);
    line-height: 1.3;
    white-space: nowrap;
  }

  .operated-since-label {
    color: var(--color-text-subtle);
  }

  /* The figures carry full text contrast and medium weight while the label
     word stays subtle: the eye lands on the column of dates, not on seven
     repetitions of the word. */
  .operated-since-value {
    color: var(--color-text);
    font-weight: var(--weight-medium);
    font-variant-numeric: tabular-nums;
  }

  .operated-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  .operated-name {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-heading-sm);
    line-height: 1.2;
    color: var(--color-text);
    margin: 0;
    text-wrap: balance;
  }

  .operated-role {
    margin: 0;
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
    color: var(--color-text);
    max-width: 62ch;
    text-wrap: pretty;
  }

  /* The note is the operating-reality beat: quieter than the role sentence,
     one step down in size and colour so it reads as a margin annotation. */
  .operated-note {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 62ch;
    text-wrap: pretty;
  }
</style>
